CONFIG_PACKAGE_csrLotApp=m
CONFIG_PACKAGE_zigbee_efr32=m 
CONFIG_PACKAGE_thread=m
CONFIG_PACKAGE_iozone=m
CONFIG_PACKAGE_charlietalk=m
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-readlink=y
CONFIG_PACKAGE_coreutils-stty=m
CONFIG_PACKAGE_mdump=m
CONFIG_PACKAGE_fdisk=m
CONFIG_PACKAGE_gdb=m
CONFIG_PACKAGE_iputils-ping=y
