CONFIG_PACKAGE_lrzsz=m
CONFIG_PACKAGE_mdadm=m
CONFIG_PACKAGE_memfeast=m
CONFIG_PACKAGE_memtester=m
CONFIG_PACKAGE_minicom=m
CONFIG_PACKAGE_mkdosfs=m
CONFIG_PACKAGE_ntfsprogs_ntfs-3g=m
CONFIG_PACKAGE_QCA_ATH_DEBUG=y
CONFIG_PACKAGE_p910nd=m
CONFIG_PACKAGE_perf=m
CONFIG_PACKAGE_perl=m
CONFIG_PACKAGE_perlbase-base=m
CONFIG_PACKAGE_perlbase-config=m
CONFIG_PACKAGE_perlbase-essential=m
CONFIG_PACKAGE_perlbase-getopt=m
CONFIG_PACKAGE_qca-fst-manager=m
